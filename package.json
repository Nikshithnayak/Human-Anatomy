{
  "name": "anatomy-atelier",
  "version": "2.0.0",
  "description": "Anatomy Atelier — Interactive 3D Human Anatomy, Spatial Learning Platform & Radiology Lab",
  "author": "Nikshith Nayak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikshithnayak/Human-Anatomy.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node scripts/sync-external-assets.mjs",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "npm run typecheck && npm run build && npx wrangler deploy",
    "build:next": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:build": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern external",
    "db:generate": "drizzle-kit generate",
    "i18n:audit": "tsx scripts/i18n-audit.mjs",
    "i18n:export": "tsx scripts/i18n-export.mjs",
    "external:sync": "node scripts/sync-external-assets.mjs",
    "ohif:dev": "node scripts/ohif-launcher.mjs",
    "z-anatomy:dev": "npm --prefix external/3d-anatomy run dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dcmjs": "^0.52.0",
    "dicom-parser": "^1.8.21",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "onnxruntime-web": "^1.31.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.13",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
